{
  "version": 1,
  "rules": [
    { "kind": "Folder", "category": "Node.js dependencies",
      "names": ["node_modules"] },
    { "kind": "Folder", "category": "Web framework cache",
      "names": [".next", ".nuxt", ".svelte-kit", ".parcel-cache", ".turbo", ".angular", ".docusaurus", ".expo", ".nx", ".wrangler", ".sass-cache"] },
    { "kind": "Folder", "category": "Test coverage output",
      "names": [".nyc_output"] },
    { "kind": "Folder", "category": "Deployment build output",
      "names": [".serverless", ".aws-sam", "storybook-static"] },
    { "kind": "Folder", "category": "Python cache",
      "names": ["__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".hypothesis", ".ipynb_checkpoints"] },
    { "kind": "Folder", "category": "Python test environments",
      "names": [".tox", ".nox"] },
    { "kind": "Folder", "category": "Python package metadata",
      "names": ["*.egg-info"] },
    { "kind": "Folder", "category": "Gradle cache",
      "names": [".gradle"] },
    { "kind": "Folder", "category": "CMake cache",
      "names": ["CMakeFiles"] },
    { "kind": "Folder", "category": "Dart tool cache",
      "names": [".dart_tool"] },
    { "kind": "Folder", "category": "Haskell build output",
      "names": [".stack-work", "dist-newstyle"] },
    { "kind": "Folder", "category": "Zig cache",
      "names": [".zig-cache", "zig-cache"] },
    { "kind": "Folder", "category": "Terraform providers",
      "names": [".terraform"] },
    { "kind": "Folder", "category": "Jekyll cache",
      "names": [".jekyll-cache"] },
    { "kind": "Folder", "category": "Swift package cache",
      "names": [".swiftpm"] },
    { "kind": "Folder", "category": "IDE settings and cache",
      "names": [".vs", ".idea"] },
    { "kind": "Folder", "category": "Python virtual environment",
      "names": [], "innerMarkers": ["pyvenv.cfg"] },

    { "kind": "Folder", "category": "Node.js build output",
      "names": ["dist", "build", "out", ".cache", ".output"], "markers": ["package.json"] },
    { "kind": "Folder", "category": "Test coverage output",
      "names": ["coverage"], "markers": ["package.json"] },
    { "kind": "Folder", "category": "Python build output",
      "names": ["build", "dist"], "markers": ["setup.py", "setup.cfg", "pyproject.toml"] },
    { "kind": "Folder", "category": "Unity generated files",
      "names": ["Library", "Temp", "Obj", "Logs"], "markers": [["Assets", "ProjectSettings"]] },
    { "kind": "Folder", "category": "Unity player build",
      "names": ["Build", "Builds"], "markers": [["Assets", "ProjectSettings"]] },
    { "kind": "Folder", "category": "Unreal generated files",
      "names": ["Binaries", "Intermediate", "Saved", "DerivedDataCache"], "markers": ["*.uproject", "*.uplugin"] },
    { "kind": "Folder", "category": "Godot import cache",
      "names": [".godot", ".import"], "markers": ["project.godot"] },
    { "kind": "Folder", "category": ".NET build output",
      "names": ["bin", "obj"], "markers": ["*.csproj", "*.fsproj", "*.vbproj", "*.sln"] },
    { "kind": "Folder", "category": "Gradle build output",
      "names": ["build", ".cxx", ".externalNativeBuild"], "markers": ["build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"] },
    { "kind": "Folder", "category": "Maven build output",
      "names": ["target"], "markers": ["pom.xml"] },
    { "kind": "Folder", "category": "Rust build output",
      "names": ["target"], "markers": ["Cargo.toml"] },
    { "kind": "Folder", "category": "CMake build output",
      "names": ["cmake-build-*", "build", "out"], "markers": ["CMakeLists.txt"] },
    { "kind": "Folder", "category": "Flutter build output",
      "names": ["build"], "markers": ["pubspec.yaml"] },
    { "kind": "Folder", "category": "Elixir build output",
      "names": ["_build", "deps"], "markers": ["mix.exs"] },
    { "kind": "Folder", "category": "PHP Composer dependencies",
      "names": ["vendor"], "markers": ["composer.json"] },
    { "kind": "Folder", "category": "Zig build output",
      "names": ["zig-out"], "markers": ["build.zig"] },
    { "kind": "Folder", "category": "Swift build output",
      "names": [".build"], "markers": ["Package.swift"] },
    { "kind": "Folder", "category": "CocoaPods dependencies",
      "names": ["Pods"], "markers": ["Podfile"] },
    { "kind": "Folder", "category": "Jekyll site output",
      "names": ["_site"], "markers": ["_config.yml"] },

    { "kind": "Folder", "category": "Possible build output",
      "names": ["bin", "obj", "build", "dist", "out", "target", "Intermediate"], "confidence": "Uncertain" },
    { "kind": "Folder", "category": "Possible temp folder",
      "names": ["Temp"], "confidence": "Uncertain" },
    { "kind": "Folder", "category": "Possible cache",
      "names": ["DerivedDataCache"], "confidence": "Uncertain" },

    { "kind": "File", "category": "System thumbnail cache",
      "names": ["Thumbs.db", "ehthumbs.db", ".DS_Store", "._*"] },
    { "kind": "File", "category": "Editor lock or swap file",
      "names": ["~$*.doc*", "~$*.xls*", "~$*.ppt*", "*.swp", "*.swo", ".~lock.*#"] },
    { "kind": "File", "category": "Temporary file",
      "names": ["*.tmp"] },
    { "kind": "File", "category": "Tool cache file",
      "names": ["*.pyc", "*.pyo", ".eslintcache", ".stylelintcache", "*.tsbuildinfo", ".coverage", ".phpunit.result.cache"] },
    { "kind": "File", "category": "Debug log or crash dump",
      "names": ["npm-debug.log*", "yarn-error.log", "pnpm-debug.log*", "hs_err_pid*.log", "*.dmp", "*.stackdump"] },
    { "kind": "File", "category": "Unity generated project file",
      "names": ["*.sln", "*.csproj"], "markers": [["Assets", "ProjectSettings"]] },
    { "kind": "File", "category": "Unreal generated project file",
      "names": ["*.sln", ".vsconfig"], "markers": ["*.uproject"] },
    { "kind": "File", "category": "Log file",
      "names": ["*.log"], "confidence": "Uncertain" }
  ]
}
